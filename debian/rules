#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors


include /usr/share/pietoolchain/rules.mk
NOTICE := $(OBJ)/apsl-notice
TOOLS := mount_hfs newfs_hfs fsck_hfs
mount_hfs_SRCS := mount_hfs/mount_hfs.c
mount_hfs_DIR := sbin
mount_hfs_LIBS := -lutil
newfs_hfs_SRCS := newfs_hfs/newfs_hfs.c newfs_hfs/makehfs.c newfs_hfs/hfs_endian.c
newfs_hfs_DIR := sbin
newfs_hfs_LIBS := -lutil -framework CoreFoundation -framework IOKit
FSCK_DFALIB := BlockCache BTree BTreeAllocate BTreeMiscOps BTreeNodeOps BTreeScanner \
	BTreeTreeOps CatalogCheck dirhardlink HardLinkCheck hfs_endian SAllocate SBTree \
	SCatalog SControl SDevice SExtents SKeyCompare SRebuildBTree SRepair SStubs SUtils \
	SVerify1 SVerify2
fsck_hfs_SRCS := $(addprefix fsck_hfs/,fsck_hfs.c fsck_messages.c utilities.c) \
	lib_fsck_hfs/cache.c debian/lib_fsck/check.c debian/lib_fsck/lib_fsck_hfs.c \
	$(addprefix lib_fsck_hfs/,fsck_debug.c fsck_strings.c fsck_hfs_strings.c fsck_journal.c) \
	$(addprefix lib_fsck_hfs/dfalib/,$(addsuffix .c,$(FSCK_DFALIB))) \
	debian/uuid.c lib_fsck_hfs/dfalib/VolumeBitmapCheck.c fsck_hfs_vers.c
fsck_hfs_DIR := sbin
fsck_hfs_FLAGS := -DBSD=1 -DDEBUG_BUILD=0 -include stdarg.h -include unistd.h -fcommon \
	-I$(SRCROOT)/debian/lib_fsck -I$(SRCROOT)/fsck_hfs -I$(SRCROOT)/lib_fsck_hfs
fsck_hfs_LIBS := -lutil -framework CoreFoundation -framework IOKit
TOOLS_LDFLAGS := -Wl,-sectcreate,__TEXT,__source,$(NOTICE)


mount_hfs_MANS := mount_hfs/mount_hfs.8:man8
newfs_hfs_MANS := newfs_hfs/newfs_hfs.8:man8
fsck_hfs_MANS := fsck_hfs/fsck_hfs.8:man8
include $(PIETOOLCHAIN)/tools.mk

$(TOOL_BINS): | $(NOTICE)
$(NOTICE):
	@mkdir -p $(OBJ)
	printf '%s\n' 'This program contains Covered Code under the Apple Public Source License 2.0.' \
		'Its Source Code is available under that License from https://github.com/blueberrypieos/hfs.' > $@

$(OBJ)/fsck_hfs/fsck_hfs_vers.c:
	@mkdir -p $(dir $@)
	printf 'const unsigned char fsck_hfsVersionString[] = "@(#)PROGRAM:fsck_hfs  PROJECT:hfs-715.120.4\\n";\nconst double fsck_hfsVersionNumber = 0;\n' > $@

all: $(TOOL_BINS)
install: install-tools
	install -d $(ROOT)/usr/include/hfs
	install -m 644 $(addprefix $(SRCROOT)/core/,hfs_format.h hfs_mount.h hfs_unistr.h) $(ROOT)/usr/include/hfs/

.PHONY: all install
